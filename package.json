{
  "name": "ai-smart-stick",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_APP_MODE=demo vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "build:user": "tsc --noEmit && VITE_APP_TARGET=user vite build",
    "build:guardian": "tsc --noEmit && VITE_APP_TARGET=guardian vite build",
    "build:demo": "VITE_APP_MODE=demo vite build --outDir dist-demo",
    "android:sync": "npm run build:user && npx cap sync android",
    "functions:build": "npm --prefix functions run build",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run -c vitest.rules.config.ts\"",
    "android:typecheck": "bash android-typecheck/check.sh",
    "test:firmware": "g++ -std=c++17 -O1 -Wall -Wextra -Ifirmware/ai_smart_stick_v1 firmware/tests/test_safety.cpp -o /tmp/aiss_fw_test && /tmp/aiss_fw_test"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-firebase/app-check": "^8.5.2",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@google/genai": "^2.24.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "firebase": "^12.19.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/google.maps": "^3.66.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
