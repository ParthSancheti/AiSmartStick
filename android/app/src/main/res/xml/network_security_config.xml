<?xml version="1.0" encoding="utf-8"?>
<!--
  v1 simple link: the stick is reached over plain HTTP at http://192.168.4.1 on its own WPA2 Wi-Fi
  (SmartStick_AI). Cleartext MUST stay allowed for that. All cloud traffic (Firebase, Maps, Gemini via
  Functions) is HTTPS regardless.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
