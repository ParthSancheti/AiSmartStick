{
  "name": "ai-smart-stick-functions",
  "private": true,
  "type": "commonjs",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "sync-shared": "node -e \"const fs=require('fs');fs.rmSync('src/shared',{recursive:true,force:true});fs.cpSync('../shared','src/shared',{recursive:true})\"",
    "build": "npm run sync-shared && tsc -p tsconfig.json",
    "typecheck": "npm run sync-shared && tsc -p tsconfig.json --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
