# Cloud Functions configuration (server-side only; never shipped in the app).
# Secrets: set with the Firebase CLI so they live in Secret Manager:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set MAPS_SERVER_KEY
# Non-secret params (this file becomes functions/.env on deploy):
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GITHUB_FIRMWARE_OWNER=project-owner
GITHUB_FIRMWARE_REPO=ai-smart-stick
REGION=asia-south1
