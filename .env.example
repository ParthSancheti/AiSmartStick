# ─────────────────────────────────────────────────────────────────────────────
# AI Smart Stick — app configuration (copy to .env). NONE of these are secrets:
# Firebase web config and a restricted Maps browser key are designed to be public.
# Gemini, Places/Routes/Geocoding keys live ONLY in Cloud Functions (functions/.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# real | demo   (production builds default to real; `npm run dev` defaults to demo)
VITE_APP_MODE=real
# user (stick user's Android app) | guardian (Guardian PWA/app) | both (dev: asks on first run)
VITE_APP_TARGET=both
VITE_APP_VERSION=0.2.0

# Firebase console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# App Check (web / Guardian PWA): reCAPTCHA Enterprise site key. Android uses Play Integrity (no key here).
VITE_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=

# Cloud Messaging web push (Guardian PWA): Project settings → Cloud Messaging → Web Push certificates
VITE_FCM_VAPID_KEY=

# Google Maps JavaScript API, map rendering only. Restrict to your Android package/SHA-1 and web origins,
# and to the Maps JavaScript API only.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Optional TURN server for guardian camera sessions (WebRTC). Comma-separate multiple URLs.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Local development against the Firebase Emulator Suite
VITE_USE_FIREBASE_EMULATORS=false
